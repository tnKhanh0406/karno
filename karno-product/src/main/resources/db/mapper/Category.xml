<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnoproduct.repository.CategoryRepo">
    <select id="findAll" resultType="com.karnoproduct.dto.response.CategoryFilterResponse">
        SELECT
            id,
            parent_id,
            name,
            slug,
            image_url
        FROM categories
        ORDER BY parent_id NULLS FIRST, name ASC
    </select>
</mapper>
