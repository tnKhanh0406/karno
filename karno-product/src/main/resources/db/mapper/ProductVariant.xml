<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnoproduct.repository.ProductVariantRepo">
    <select id="getCartInfoByVariantIds" resultType="com.karnoproduct.repository.projection.ProductVariantProjection">
        SELECT
            pv.id,
            pv.name,
            pv.primary_img,
            pv.price,
            p.id AS product_id,
            p.name AS product_name,
            p.thumbnail_img,
            p.shop_id,
            p.status AS product_status
        FROM product_variants pv
        JOIN products p ON p.id = pv.product_id
        WHERE pv.id IN
        <foreach collection="variantIds"
                 item="variantId"
                 open="("
                 separator=","
                 close=")">
            #{variantId}
        </foreach>
    </select>

</mapper>