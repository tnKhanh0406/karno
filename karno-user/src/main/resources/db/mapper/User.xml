<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnouser.repository.UserRepo">
    <select id="findUsersByIds" resultType="com.karnouser.dto.response.ReviewUserResponse">
        SELECT
            id,
            full_name AS name,
            avatar_url
        FROM users
        WHERE id IN
        <foreach collection="userIds"
                 item="userId"
                 open="("
                 separator=","
                 close=")">
            #{userId}
        </foreach>
    </select>
</mapper>