<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnouser.repository.ShopRepo">
    <select id="findShopInformationById" resultType="com.karnouser.dto.response.ShopInformationResponse">
        SELECT
            id,
            name,
            description,
            logo_url AS logoUrl
        FROM shops
        WHERE id = #{shopId}
        AND status = 'ACTIVE'
    </select>

    <select id="findShopInformationByIds" resultType="com.karnouser.dto.response.ShopInformationResponse">
        SELECT
            id,
            name,
            description,
            logo_url AS logoUrl
        FROM shops
        WHERE id IN
        <foreach collection="shopIds"
                 item="shopId"
                 open="("
                 separator=","
                 close=")">
            #{shopId}
        </foreach>
        AND status = 'ACTIVE'
    </select>

    <select id="findShopLocationsByIds" resultType="com.karnouser.dto.response.ShopLocationResponse">
        SELECT
            s.id AS shopId,
            s.name,
            u.phone AS phone,
            s.address,
            s.latitude,
            s.longitude
        FROM shops s
        JOIN users u ON s.owner_id = u.id
        WHERE s.id IN
        <foreach collection="shopIds"
                 item="shopId"
                 open="("
                 separator=","
                close=")">
            #{shopId}
        </foreach>
    </select>
</mapper>