<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnouser.repository.ShopRepo">
    <select id="findShopInformationById" resultType="com.karnouser.dto.response.ShopInformationResponse">
        SELECT
            id,
            name,
            description,
            logo_url AS logoUrl
        FROM shops
        WHERE id = #{shopId}
        AND status = 'ACTIVE'
    </select>
</mapper>