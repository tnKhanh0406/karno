<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.karnoorder.repository.CartRepo">
    <select id="findCartIdByUserId" resultType="java.util.UUID">
        SELECT
            c.id
        FROM carts c
        WHERE c.customer_id = #{userId}
    </select>
    <insert id="insertCart">
        INSERT INTO carts ( id, customer_id )
        VALUES ( #{id}, #{userId} )
    </insert>
</mapper>